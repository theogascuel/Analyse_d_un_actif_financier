import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
import scipy.stats as stats

fichier = "C:\\Users\\theog\\OneDrive\\Desktop\\projet1\\PCEU ETF Stock Price History.csv" #Récupération fichier
df = pd.read_csv(fichier) #Lecture du fichier

df['Date'] = pd.to_datetime(df['Date']) #conversion des dates de str à date python
df = df.sort_values('Date') #tri croissant/ordre chronologique des dates
df = df.set_index('Date') #transforme 'Date' en index de DataFrame
df['rendement_simple'] = [None] + [(df.iloc[i]['Price'] - df.iloc[i-1]['Price']) / df.iloc[i-1]['Price'] for i in range(1, len(df))] # Calcul des rendements simple
df['rendement_log'] = [None] + [np.log(df.iloc[i]['Price'] / df.iloc[i-1]['Price']) for i in range(1,len(df))] # Calcul des rendements log
df['simple_cumulé'] = ((1 + df['rendement_simple']).cumprod()) - 1 # Rendements cumulés
df['log_cumulé'] = df['rendement_log'].cumsum()


fig, axes = plt.subplots(1, 2, figsize=(18,6))  #Création de deux graphiques côte à côte pour faciliter la comparaison
# Premier graphique : prix
axes[0].plot(df.index, df['Price'], color='blue', label='Prix ajusté')
axes[0].set_title("Prix ajusté de l'ETF")
axes[0].set_xlabel("Date")
axes[0].set_ylabel("Prix (€)")
formatter = mdates.DateFormatter('%Y-%m')
axes[0].xaxis.set_major_formatter(formatter)
decoupage = mdates.MonthLocator(interval=3)
axes[0].xaxis.set_major_locator(decoupage)
axes[0].tick_params(axis='x', rotation=45)
axes[0].grid(alpha=0.3)
axes[0].legend()
axes[0].set_xlim(df.index.min(), df.index.max())
# Deuxième graphique : rendements cumulés
axes[1].plot(df.index, df['simple_cumulé'], color='green', label='Simple cumulé')
axes[1].plot(df.index, df['log_cumulé'], color='red', linestyle='--', label='Logarithme cumulé')
axes[1].set_title("Rendements cumulés")
axes[1].set_xlabel("Date")
axes[1].set_ylabel("Rendement cumulé")
axes[1].xaxis.set_major_formatter(formatter)
axes[1].xaxis.set_major_locator(decoupage)
axes[1].tick_params(axis='x', rotation=45)
axes[1].grid(alpha=0.3)
axes[1].legend()
axes[1].set_xlim(df.index.min(), df.index.max())
plt.tight_layout()  # Ajuste l'espace automatiquement
#plt.show()

df_clean = df['rendement_log'][1:] 
moyenne = df_clean.mean()
variance = df_clean.var()
asymetrie = df_clean.skew()
queue = df_clean.kurtosis()
print(f"Moyenne: {moyenne}")
print(f"Variance: {variance}")
print(f"Asymétrie: {asymetrie}") # =0 pour loi normale
print(f"Queue: {queue}") # =3 pour loi normale 


plt.figure(figsize=(10,6))
plt.hist(df_clean, bins=50, density=True, alpha=0.6, color='skyblue')

# Ajuster une normale
mu = df_clean.mean() #moyenne rendement journalier
sigma = df_clean.std() #écart-type des rendements journaliers = volatilité journalière 
x = np.linspace(df_clean.min(), df_clean.max(), 100)
plt.plot(x, stats.norm.pdf(x, mu, sigma), color='red', label='Loi normale')
plt.title("Histogramme des rendements log")
plt.xlabel("Rendement")
plt.ylabel("Densité")
plt.legend()
plt.show()

jb_test = stats.jarque_bera(df_clean)
print("Test de Jarque-Bera:", jb_test)
